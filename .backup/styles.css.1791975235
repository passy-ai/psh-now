/* psh.now — design system
   One accent, one radius, dark only. Every page uses the same shell. */

:root {
  --bg: #0a0a0a;
  --surface: #111319;
  --surface-2: #171a22;
  --line: #232838;
  --line-soft: #1b1f2b;
  --text: #eef1f7;
  --dim: #8b94a7;
  --green: #22c55e;
  --red: #f87171;
  --field-bg: #101218;
  --approve-bg: #22c55e;
  --approve-ink: #04140a;
  --deny-bg: #17181c;
  --deny-ink: #f87171;
  --deny-border: #26282f;
  --tab-accent: #ffffff;
  --badge-bg: #1c1f27;
  --badge-ink: #cfd4dd;
  --badge-border: #2a2f3a;
  --primary-bg: #ffffff;
  --primary-ink: #0b0d12;
  --hover-border: #3a4050;
  --radius: 16px;
  --radius-sm: 11px;
}

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html,
body {
  margin: 0;
  min-height: 100%;
}

body {
  background: var(--bg);
  color: var(--text);
  font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  padding: env(safe-area-inset-top) env(safe-area-inset-right)
    env(safe-area-inset-bottom) env(safe-area-inset-left);
}

a {
  color: var(--text);
  text-decoration: none;
}

.hide {
  display: none !important;
}
.show {
  display: block;
}
.muted {
  color: var(--dim);
}
.center {
  text-align: center;
}

/* ---------- shell ---------- */

.wrap {
  max-width: 1080px;
  margin: 0 auto;
  padding: 30px 26px 90px;
}
/* The minimal app: a single column of channel cards. */
.wrap.app {
  max-width: 1040px;
  padding: 24px 20px 48px;
}

/* ---------- nav links ---------- */
.nav-links {
  display: flex;
  gap: 24px;
  margin-left: 10px;
}
.nav-link.active {
  color: var(--text);
  font-weight: 600;
}

/* ---------- approvals page ---------- */
.approvals {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.approval-card {
  border: 1px solid var(--line-soft);
  border-top: 2px solid var(--accent, #6c8cff);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.022);
  padding: 24px;
}
.approval-title {
  margin: 6px 0 10px;
  font-size: 22px;
  font-weight: 600;
}
.approval-msg {
  margin: 0 0 20px;
  color: var(--dim);
  font-size: 15px;
  line-height: 1.5;
  white-space: pre-wrap;
}
.approval-actions {
  display: flex;
  gap: 10px;
}
.approval-actions .btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 11px 22px;
  border-radius: 11px;
  font-weight: 600;
}
.approvals-empty {
  text-align: center;
  padding: 64px 0 40px;
}
.approvals-empty-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  border: 1px solid var(--line);
  color: var(--green);
  margin-bottom: 14px;
}
.approvals-empty h2 {
  font-size: 20px;
  font-weight: 600;
  margin: 0 0 6px;
}

/* ---------- channel search ---------- */
.search-row {
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid transparent;
  border-radius: 14px;
  padding: 0 16px;
  background: var(--surface-2);
  margin-bottom: 18px;
  transition: border-color 0.12s;
}
.search-row:focus-within {
  border-color: var(--hover-border);
}
.search-icon {
  color: var(--dim);
  display: inline-flex;
}
.search-row .field.search {
  border: 0;
  background: none;
}
.search-row .field.search:focus {
  outline: none;
}

.page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}
.page-title {
  font-size: 30px;
  font-weight: 700;
  margin: 0;
  letter-spacing: -0.5px;
}
.page-sub {
  color: var(--dim);
  margin: 6px 0 0;
  font-size: 16px;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.icon {
  display: inline-block;
  vertical-align: -2px;
  flex: none;
}

.icon-btn {
  display: inline-grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 9px;
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--dim);
  cursor: pointer;
  padding: 0;
}
.icon-btn:hover {
  color: var(--text);
  border-color: var(--hover-border);
}
.icon-btn.sm {
  width: 30px;
  height: 30px;
}

/* ---------- buttons ---------- */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  border-radius: 9px;
  font-weight: 600;
  cursor: pointer;
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--text);
  padding: 10px 16px;
  font-size: 14px;
  font-family: inherit;
  transition: border-color 0.12s, background 0.12s;
}
.btn:hover {
  border-color: var(--hover-border);
}
.btn.primary {
  background: var(--primary-bg);
  color: var(--primary-ink);
  border-color: var(--primary-bg);
  border-radius: 12px;
  padding: 13px 18px;
  font-size: 15px;
}
.btn.primary:hover {
  filter: brightness(0.92);
}
.btn.sm {
  padding: 8px 13px;
  font-size: 13.5px;
}
.btn.block {
  width: 100%;
}
.btn.ghost {
  background: transparent;
}
.btn.danger-ghost {
  background: transparent;
  color: var(--red);
  border-color: #2a1d20;
}
.btn.danger-ghost:hover {
  border-color: var(--red);
}
.btn.approve {
  background: var(--approve-bg);
  color: var(--approve-ink);
  border-color: var(--approve-bg);
}
.btn.deny {
  background: var(--deny-bg);
  color: var(--deny-ink);
  border-color: var(--deny-border);
}
.danger {
  color: var(--red);
}

/* ---------- cards ---------- */

.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 16px;
  margin-top: 14px;
}
.label {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--dim);
  margin-bottom: 7px;
}

/* ---------- forms ---------- */

.field {
  width: 100%;
  background: var(--surface-2);
  border: 1px solid transparent;
  border-radius: 14px;
  color: var(--text);
  padding: 14px 16px;
  font-size: 15px;
  font-family: inherit;
  transition: border-color 0.12s, background 0.12s;
}
.field::placeholder {
  color: #5c6478;
}
.field:focus {
  outline: none;
  border-color: var(--hover-border);
}
textarea.field {
  resize: vertical;
  min-height: 58px;
}
.field-group {
  margin-bottom: 16px;
}
.field-label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--dim);
  margin-bottom: 7px;
}
.input-row {
  display: flex;
  gap: 10px;
  align-items: center;
}
.input-row .field {
  flex: 1;
}

.inline-form {
  margin: 24px 0 8px;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
}
.inline-form-row {
  display: flex;
  gap: 10px;
  align-items: center;
}
.inline-form-row .field {
  flex: 1;
}
.inline-form .field {
  margin-bottom: 8px;
}
.inline-form .btn {
  margin-bottom: 0;
}
.prompt {
  background: var(--field-bg);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 12px;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12.5px;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
  color: var(--text);
  margin: 8px 0 12px;
}

/* ---------- sections (open / closed / settings) ---------- */

.section-label {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--dim);
  text-transform: uppercase;
  margin: 32px 0 4px;
}
.channel-list {
  margin-top: 30px;
}
.closed-section {
  margin-top: 36px;
}
.section-toggle {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: none;
  border: 0;
  cursor: pointer;
  color: var(--text);
  font-size: 15px;
  font-weight: 600;
  padding: 8px 2px;
}
.section-toggle .chev {
  color: var(--dim);
  display: inline-flex;
  transition: transform 0.15s;
}
.section-toggle.open .chev {
  transform: rotate(180deg);
}
.closed-list {
  margin-top: 2px;
}
.closed-list > .card {
  margin-top: 10px;
}
.empty-note {
  color: var(--dim);
  padding: 44px 0;
  text-align: center;
}

/* ---------- channel ---------- */

.channel {
  border-top: 1px solid var(--line-soft);
  padding-top: 24px;
  margin-top: 24px;
}
.channel:first-child {
  border-top: 0;
  padding-top: 0;
  margin-top: 0;
}
.channel-head {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 14px;
  background: none;
  border: 0;
  cursor: pointer;
  padding: 0;
  color: inherit;
  text-align: left;
}
.channel-name {
  font-size: 20px;
  font-weight: 700;
}
.channel-meta {
  color: var(--dim);
  font-size: 15px;
}
.channel-head .chev {
  margin-left: auto;
  color: var(--dim);
  font-size: 14px;
}
.pending-badge {
  font-size: 14px;
  padding: 3px 12px;
  border-radius: 999px;
  background: var(--badge-bg);
  color: var(--badge-ink);
  border: 1px solid var(--badge-border);
}
.channel-body {
  margin-top: 0;
}
.channel-connect {
  margin-top: 18px;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
}
.channel-connect .connect-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.channel-connect .connect-head .btn {
  white-space: nowrap;
  flex-shrink: 0;
}
.channel-connect .connect-label {
  margin-bottom: 0;
}
.channel-connect .key-value {
  white-space: normal;
  word-break: break-word;
  line-height: 1.5;
}
.channel-tabs {
  display: flex;
  gap: 26px;
  margin-top: 20px;
  border-bottom: 1px solid var(--line-soft);
}
.ctab {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: none;
  border: 0;
  cursor: pointer;
  color: var(--dim);
  font-size: 15px;
  font-weight: 500;
  padding: 0 0 12px;
  margin-bottom: -1px;
  border-bottom: 2px solid transparent;
  transition: color 0.12s;
}
.ctab:hover {
  color: var(--text);
}
.ctab.active {
  color: var(--text);
  border-bottom-color: var(--tab-accent);
}

/* ---------- requests table ---------- */

.req-table {
  margin-top: 4px;
}
.req-row {
  display: grid;
  grid-template-columns: 1.4fr 1.8fr auto auto;
  align-items: center;
  gap: 16px;
  padding: 14px 0;
  border-bottom: 1px solid var(--line-soft);
}
.req-head {
  color: var(--dim);
  font-weight: 500;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 8px 0;
}
.req-head .right {
  text-align: right;
}
.req-title {
  font-weight: 600;
  font-size: 14px;
}
.req-desc {
  color: var(--dim);
  font-size: 13px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.req-status {
  display: flex;
}
.req-actions {
  display: flex;
  gap: 8px;
  justify-content: flex-end;
}
.req-actions .btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 7px 14px;
  border-radius: 9px;
  font-weight: 600;
  font-size: 13px;
}
.table-empty {
  color: var(--dim);
  padding: 16px 0;
}

/* ---------- history ---------- */

.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  background: none;
  border: 0;
  cursor: pointer;
  color: var(--dim);
  font-size: 17px;
  padding: 22px 0 0;
}
.history-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.history-row .chev {
  display: inline-flex;
}
.history-body {
  padding: 10px 0;
}

/* ---------- members / keys panes ---------- */

.pane-note {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--dim);
  font-size: 15px;
  margin: 16px 0;
}
.member-list,
.key-list {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-bottom: 16px;
}
.member-row,
.key-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--line-soft);
}
.member-name,
.key-name {
  font-weight: 600;
  font-size: 14.5px;
}
.member-role,
.key-prefix {
  color: var(--dim);
  font-size: 13px;
}
.key-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.key-prefix {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

/* ---------- settings pane ---------- */

.settings-pane {
  padding: 24px 0 6px;
  max-width: 560px;
}
.settings-head {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
  font-size: 15px;
  margin-bottom: 10px;
}
.settings-head .btn,
.settings-head .icon-btn {
  margin-left: auto;
}
.hist-table .req-row {
  grid-template-columns: 0.9fr 1.2fr 1.6fr 0.7fr 1fr auto;
}
.req-agent {
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-size: 13px;
}
.req-sub {
  color: var(--dim);
  font-size: 11px;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}
.req-by {
  -webkit-line-clamp: 1;
}
.settings-pane .muted {
  margin: 0 0 14px;
}
.settings-sep {
  height: 1px;
  background: var(--line-soft);
  margin: 24px 0;
}
.company {
  margin: 10px 0 14px;
}
.company > summary {
  cursor: pointer;
  color: var(--dim);
  font-size: 13.5px;
  padding: 6px 0;
}
.company .field {
  margin-bottom: 8px;
}
.topup-summary {
  margin-bottom: 12px;
}
.topup-summary .kv {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  padding: 4px 0;
}

/* ---------- account card ---------- */

.account-card {
  margin-top: 26px;
  padding: 24px 22px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--surface);
}
.account-id {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12px;
}
.account-handle {
  font-size: 20px;
  font-weight: 700;
  margin: 0;
  letter-spacing: -0.3px;
}
.account-handle.is-key {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0;
  word-break: break-all;
}
.account-edit {
  margin: 14px 0 0;
  display: flex;
}
.pill {
  font-size: 12px;
  padding: 3px 10px;
  border-radius: 999px;
  background: transparent;
  border: 1px solid var(--line);
  color: var(--dim);
}
.pill.free {
  border-color: rgba(34, 197, 94, 0.4);
  color: var(--green);
}
.claim-form {
  margin: 20px auto 4px;
  padding-top: 20px;
  border-top: 1px solid var(--line-soft);
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-width: 520px;
}
.key-line,
.connect-line {
  margin-top: 20px;
}
.key-label,
.connect-label {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: var(--dim);
  margin-bottom: 7px;
}
.key-field {
  display: flex;
  align-items: center;
  gap: 8px;
}
.key-value {
  flex: 1;
  min-width: 0;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 14px;
  background: var(--field-bg);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 9px 12px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.key-blur {
  filter: blur(5px);
  user-select: none;
  transition: filter 0.15s;
}
.key-value.revealed .key-blur {
  filter: none;
  user-select: auto;
}
.handle-status {
  font-size: 13px;
  color: var(--dim);
  min-width: 76px;
}
.handle-status.ok {
  color: var(--green);
}
.handle-status.bad {
  color: var(--red);
}
.signout {
  margin-top: 34px;
}

.limit-cta {
  margin-top: 16px;
  padding: 14px;
  border: 1px solid rgba(248, 113, 113, 0.35);
  border-radius: 12px;
  background: rgba(248, 113, 113, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  text-align: center;
  font-size: 14px;
}

/* ---------- sign in ---------- */

#paired {
  opacity: 0;
  transition: opacity 0.22s ease;
}
#paired.ready {
  opacity: 1;
}

.signin {
  max-width: 420px;
  margin: 9vh auto 0;
  padding: 0 4px 48px;
  display: flex;
  flex-direction: column;
  gap: 18px;
  text-align: left;
}
.signin-title {
  margin: 0;
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.02em;
}
.signin-sub {
  margin: -10px 0 4px;
  color: var(--dim);
  font-size: 15px;
}
.signin-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
  text-align: left;
}
.field-label {
  display: block;
  color: var(--text);
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
}
.signin-form .field {
  width: 100%;
}
.signin-form .field-label:not(:first-child) {
  margin-top: 16px;
}
/* Small helper copy under a field or button. */
.form-hint {
  margin: -6px 0 0;
  color: var(--dim);
  font-size: 13.5px;
}
/* Dev-only code helper shown above the code field. */
.code-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 10px;
  flex-wrap: wrap;
}
.code-tools code {
  color: var(--text);
  font-size: 13px;
}
.code-tools .btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.linklike {
  background: none;
  border: 0;
  color: var(--dim);
  font-size: 13px;
  font-family: inherit;
  cursor: pointer;
  padding: 4px;
  text-decoration: underline;
  text-underline-offset: 3px;
}
.linklike:hover {
  color: var(--text);
}
.signin-foot {
  margin-top: 12px;
  padding-top: 24px;
  border-top: 1px solid var(--line-soft);
  text-align: center;
  color: var(--dim);
  font-size: 14px;
}
.signin-foot a {
  color: var(--dim);
}
.signin-foot a:hover {
  color: var(--text);
}

/* ---------- misc ---------- */

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.kv-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 10px;
}
.kv {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
}
.kv span:first-child {
  color: var(--dim);
}
.code {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 12px;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 13px;
  word-break: break-all;
}
.qr {
  display: block;
  width: 200px;
  height: 200px;
  margin: 12px auto 0;
  background: #fff;
  border-radius: 12px;
}
.conn-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 12px;
}
.conn {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 0;
  border-bottom: 1px solid var(--line-soft);
}
.conn-empty {
  color: var(--dim);
  font-size: 14px;
  padding: 8px 0;
}
.conn-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface);
  margin-bottom: 18px;
}
/* The channel-level connect card sits right under the channel head. */
.channel > .conn-card {
  margin: 14px 0 4px;
}

/* ---------- channel card ---------- */
.channel-card {
  border: 1px solid var(--line-soft);
  border-top: 2px solid var(--accent, var(--line));
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.022);
  padding: 24px;
  margin-top: 20px;
}
.ch-head {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}
.ch-head-text {
  flex: 1;
  min-width: 0;
}
.ch-kicker {
  display: block;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dim);
  margin-bottom: 4px;
}
.ch-name {
  margin: 0;
  font-size: 22px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 10px;
}
.ch-color {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 2px solid var(--line);
  cursor: pointer;
  flex-shrink: 0;
  overflow: hidden;
  padding: 0;
}
.ch-color input {
  opacity: 0;
  width: 100%;
  height: 100%;
  cursor: pointer;
}
.ch-qr {
  width: 84px;
  height: 84px;
  flex-shrink: 0;
  border-radius: 10px;
  background: #fff;
  padding: 6px;
}
.ch-qr-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}
.ch-qr-hint {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--dim);
  font-size: 12.5px;
  line-height: 1.3;
  white-space: nowrap;
}
.ch-connect {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 18px;
}
.ch-connect .btn.pill {
  white-space: normal;
  text-align: left;
}
.ch-prompt {
  margin: 12px 0 4px;
  padding: 14px;
  border: 1px solid var(--line-soft);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.03);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12.5px;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
  color: var(--text);
}
.ch-prompt .key-blur {
  filter: blur(4px);
}
.ch-prompt.revealed .key-blur {
  filter: none;
}
.ch-sec {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  background: none;
  border: 0;
  border-top: 1px solid var(--line-soft);
  padding: 16px 0 6px;
  margin-top: 14px;
  color: var(--text);
  font: inherit;
  font-weight: 600;
  font-size: 15px;
  cursor: pointer;
}
.ch-sec .chev {
  color: var(--dim);
}
.conn-table {
  display: flex;
  flex-direction: column;
}
.conn-trow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid var(--line-soft);
  font-size: 14px;
}
.conn-trow:last-child {
  border-bottom: 0;
}
.conn-thead {
  color: var(--dim);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.conn-tname {
  font-weight: 600;
}
.conn-tstatus {
  color: var(--dim);
}

/* settings blocks */
.set-block {
  margin-bottom: 22px;
}
.slug-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.slug-prefix {
  color: var(--dim);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}
.conn-card-body {
  flex: 1;
  min-width: 0;
}
.conn-qr {
  width: 96px;
  height: 96px;
  flex-shrink: 0;
  border-radius: 10px;
  background: #fff;
  padding: 6px;
}
/* Connections tab rows: editable name + meta + actions */
.conn-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 0;
  border-bottom: 1px solid var(--line-soft);
}
.conn-row:last-child {
  border-bottom: 0;
}
.conn-name {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 8px;
  color: var(--text);
  font: inherit;
  font-weight: 600;
  font-size: 14.5px;
  padding: 4px 6px;
}
.conn-name:hover {
  border-color: var(--line);
}
.conn-name:focus {
  outline: none;
  border-color: var(--line);
  background: var(--surface);
}
.conn-sub {
  color: var(--dim);
  font-size: 13px;
  white-space: nowrap;
}
.session-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 0;
}
.grow {
  flex: 1;
}
.sub {
  color: var(--dim);
  font-size: 13px;
}
.online {
  color: var(--green);
}
.offline {
  color: var(--dim);
}
.status-pill {
  font-size: 12px;
  padding: 2px 9px;
  border-radius: 999px;
  border: 1px solid var(--line);
  color: var(--dim);
}
.status-pill.approved {
  color: var(--green);
  border-color: rgba(34, 197, 94, 0.4);
}
.status-pill.denied {
  color: var(--red);
  border-color: rgba(248, 113, 113, 0.4);
}
.status-pill.pending {
  color: var(--text);
}
.status-pill.expired {
  color: var(--dim);
}
.revoke {
  background: none;
  border: 0;
  color: var(--dim);
  cursor: pointer;
  font-size: 13px;
}
.revoke:hover {
  color: var(--red);
}

.spinner {
  display: inline-block;
  width: 14px;
  height: 14px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: var(--text);
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.toast {
  position: fixed;
  left: 50%;
  bottom: 26px;
  transform: translateX(-50%) translateY(20px);
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--line);
  border-radius: 11px;
  padding: 11px 18px;
  font-size: 14px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s, transform 0.2s;
  z-index: 60;
}
.toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* ---------- top nav ---------- */

.nav {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  padding: 14px 26px;
  background: color-mix(in srgb, var(--bg) 88%, transparent);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line-soft);
}
.nav-brand {
  display: flex;
  align-items: center;
  gap: 9px;
  font-weight: 700;
  font-size: 16px;
  color: var(--text);
}
.nav-brand .mark {
  width: 22px;
  height: 22px;
  display: block;
  /* The mark is a black outline; invert it for the dark surface. */
  filter: invert(1);
}
/* Docs link carries a small icon. */
.nav-docs {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.nav-docs svg {
  color: var(--dim);
}
/* "Claim account" badge that sits beside the avatar. */
.nav-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--surface-2);
  border: 1px solid var(--line);
  color: var(--text);
  border-radius: 999px;
  padding: 6px 12px;
  font-size: 13px;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
}
.nav-badge:hover {
  border-color: var(--text);
}
.nav-badge svg {
  color: #e0662b;
}
.nav-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}
.nav-link {
  color: var(--dim);
  font-size: 14px;
}
.nav-link:hover {
  color: var(--text);
}
.btn.pill {
  border-radius: 999px;
  padding: 9px 16px;
}

.avatar-wrap {
  position: relative;
}
.avatar {
  width: 34px;
  height: 34px;
  border-radius: 999px;
  background: #e0662b;
  color: #fff;
  border: 0;
  cursor: pointer;
  font-weight: 700;
  font-size: 15px;
}
.menu {
  position: absolute;
  right: 0;
  top: 44px;
  z-index: 30;
  min-width: 290px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 6px;
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
}
.menu-field {
  padding: 10px 12px;
  border-bottom: 1px solid var(--line-soft);
}
.menu-label {
  display: block;
  color: var(--dim);
  font-size: 10.5px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 5px;
}
.menu-key {
  display: flex;
  align-items: center;
  gap: 6px;
}
.menu-key code {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
  color: var(--text);
}
.menu-note {
  display: block;
  color: var(--dim);
  font-size: 11.5px;
  margin-top: 6px;
}
.menu-head {
  padding: 10px 12px 12px;
  border-bottom: 1px solid var(--line-soft);
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.menu-id {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.menu-id #menuName {
  font-weight: 600;
}
.menu-id #menuEmail {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12.5px;
}
/* Status pill: Anonymous / Free / Token. */
.badge {
  flex: none;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.02em;
  padding: 4px 10px;
  border-radius: 999px;
  background: var(--surface-2);
  border: 1px solid var(--line);
  color: var(--dim);
  white-space: nowrap;
}
.badge.free {
  color: #34c759;
  border-color: color-mix(in srgb, #34c759 45%, var(--line));
  background: color-mix(in srgb, #34c759 12%, transparent);
}
.badge.token {
  color: #6c8cff;
  border-color: color-mix(in srgb, #6c8cff 45%, var(--line));
  background: color-mix(in srgb, #6c8cff 12%, transparent);
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 9px;
  width: 100%;
  text-align: left;
  background: none;
  border: 0;
  color: var(--text);
  padding: 10px 12px;
  border-radius: 9px;
  cursor: pointer;
  font-size: 14px;
  font-family: inherit;
}
.menu-item:hover {
  background: var(--surface-2);
}
.menu-item svg {
  color: var(--dim);
}
.menu-item.danger {
  color: var(--red);
}
.menu-item.danger svg {
  color: var(--red);
}
.menu-progress {
  display: flex;
  align-items: center;
  gap: 8px;
}
.menu-progress .bar {
  flex: 1;
  height: 6px;
  border-radius: 999px;
  background: var(--surface-2);
  overflow: hidden;
}
.menu-progress .bar span {
  display: block;
  height: 100%;
  width: 0;
  background: #6c8cff;
  border-radius: 999px;
  transition: width 0.3s ease;
}
.menu-pct {
  color: var(--dim);
  font-size: 12px;
  white-space: nowrap;
}

/* ---------- empty state ---------- */

.empty-state {
  text-align: center;
  padding: 14vh 0 0;
}
.empty-state h2 {
  font-size: 20px;
  font-weight: 600;
  margin: 0 0 8px;
}
.empty-state .empty-note {
  color: var(--dim);
  font-size: 14px;
  margin: 0 0 20px;
}
.empty-actions {
  display: flex;
  gap: 10px;
  justify-content: center;
  flex-wrap: wrap;
}

/* ---------- docs ---------- */

.docs {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 48px;
  max-width: 1080px;
  margin: 0 auto;
  padding: 40px 26px 120px;
}
.docs-side {
  position: sticky;
  top: 78px;
  align-self: start;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.docs-group {
  font-size: 12px;
  font-weight: 600;
  color: var(--dim);
  margin: 18px 0 6px;
}
.docs-group:first-child {
  margin-top: 0;
}
.docs-link {
  color: var(--dim);
  padding: 7px 12px;
  border-radius: 9px;
  font-size: 14px;
}
.docs-link:hover {
  color: var(--text);
}
.docs-link.active {
  background: var(--surface);
  color: var(--text);
}
.docs-main {
  min-width: 0;
}
.docs-main h1 {
  font-size: 30px;
  font-weight: 700;
  margin: 0 0 18px;
}
.docs-main h2 {
  font-size: 21px;
  font-weight: 700;
  margin: 40px 0 12px;
}
.docs-main p,
.docs-main li {
  color: var(--text);
  line-height: 1.65;
}
.docs-main p {
  margin: 12px 0;
}
.docs-main ul {
  padding-left: 20px;
}
.docs-main code {
  background: var(--surface-2);
  border-radius: 6px;
  padding: 2px 6px;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 13px;
}
.docs-main pre {
  position: relative;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 16px 44px 16px 16px;
  overflow-x: auto;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 13px;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
  margin: 14px 0;
}
.docs-main pre code {
  background: none;
  padding: 0;
}
.pre-copy {
  position: absolute;
  top: 10px;
  right: 10px;
  background: none;
  border: 0;
  color: var(--dim);
  cursor: pointer;
  padding: 4px;
}
.pre-copy:hover {
  color: var(--text);
}
.docs-main a {
  color: var(--text);
  text-decoration: underline;
  text-decoration-color: var(--line);
}
.docs-main .btn.pill {
  margin: 8px 0 4px;
}

@media (max-width: 820px) {
  .docs {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .docs-side {
    position: static;
    flex-direction: row;
    flex-wrap: wrap;
  }
  .docs-group {
    width: 100%;
  }
}

/* ---------- responsive ---------- */

@media (max-width: 720px) {
  .wrap {
    padding: 22px 18px 80px;
  }
  .page-title {
    font-size: 24px;
  }
  .req-row {
    grid-template-columns: 1fr;
    gap: 4px;
    padding: 16px 0;
  }
  .req-head {
    display: none;
  }
  .req-actions {
    justify-content: flex-start;
    margin-top: 12px;
  }
  .channel-tabs {
    gap: 20px;
  }
}

/* Phones (iPhone 12 mini = 375px): keep the nav on one line. */
@media (max-width: 480px) {
  .nav {
    gap: 12px;
    padding: 12px 14px;
  }
  .nav-brand {
    font-size: 15px;
    gap: 7px;
  }
  /* The mark stays; the wordmark and the top Docs link live in the menu. */
  .nav-brand-text,
  .nav-docs {
    display: none;
  }
  .nav-links {
    gap: 14px;
    margin-left: 0;
  }
  .nav-link {
    font-size: 13px;
  }
  .nav-actions {
    gap: 10px;
  }
  .nav-badge {
    padding: 5px 9px;
    font-size: 12px;
  }
  .nav-badge svg {
    display: none;
  }
}
