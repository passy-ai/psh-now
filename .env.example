# --- psh.now server ---
PORT=3000
HOST=0.0.0.0

# Public base URL used to build pairing links / QR codes.
# In dev, http://localhost:3000 works. In prod, https://psh.now
PUBLIC_BASE_URL=http://localhost:3000

# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/psh

# How long an agent request waits for a human decision before auto-denying.
# Keep this below your proxy/CDN timeout (Cloudflare returns 524 at ~100s).
DEFAULT_TIMEOUT_MS=90000

# How long a pairing QR/token stays valid.
PAIRING_TTL_MS=600000

# Anonymous (unclaimed) workspaces are deleted after this long.
UNCLAIMED_TTL_MS=604800000

# How long a claim code stays valid.
CLAIM_TTL_MS=900000

# Dev conveniences. Both default ON only when PUBLIC_BASE_URL points at this
# machine (localhost / 127.0.0.1); anywhere else they default OFF and need an
# explicit =1. Even when on, the sign-in code is only returned to a request that
# came from this machine - a deployed host always emails it.
# PSH_DEV_CLAIM gives the one-per-account free pack without the billing provider.
# PSH_LOG_CODE prints sign-in codes to the console/local UI instead of emailing.
PSH_DEV_CLAIM=1
PSH_LOG_CODE=1

# Requests one workspace may add for free while no payment provider is approved.
# Capped on purpose: an unapproved host must not be unlimited free capacity.
PSH_DIRECT_TOKENS_MAX=1000

# Secret used to encrypt recoverable agent keys at rest. CHANGE THIS in
# production (any long random string). Without it, the dev default is used.
PSH_SECRET=change-me-to-a-long-random-string

# Set to "production" to enforce secure cookies / stricter logging. With docker compose
# this is set for you, and PSH_SECRET / PUBLIC_BASE_URL are mandatory.
NODE_ENV=development

# --- Mail (required for sign-in on a deployed instance) ---
# Locally, leave these unset: with NODE_ENV != production the code is printed to this
# console and returned to the UI, so you can sign in with no mail provider at all.
# On a real deployment, set MAIL_FROM and exactly one of the two transports.
# MAIL_FROM="psh.now <no-reply@example.com>"
# SMTP_URL=smtps://user:password@smtp.example.com:465
# RESEND_API_KEY=re_...
MAIL_FROM=
SMTP_URL=
RESEND_API_KEY=

# --- Optional: serve HTTPS/WSS directly (no Caddy/nginx needed) ---
# TLS_CERT_FILE=/etc/letsencrypt/live/psh.now/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/psh.now/privkey.pem

# --- Optional: Cloudflare Tunnel (Zero Trust) ---
# Point the public hostname's Service at http://localhost:4321 and run cloudflared with the
# token. The tunnel scripts that used to live here were specific to our own deployment.
# CF_TUNNEL_HOSTNAME=psh.now
# CF_TUNNEL_TOKEN=eyJ...
